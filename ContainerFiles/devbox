# Install JetBrains Toolbox app and expose a stable binary path.
# 2. Fetch and extract the latest JetBrains Toolbox release
RUN TOOLBOX_URL=$(curl -s "https://data.services.jetbrains.com/products/releases?code=TBA&latest=true&type=release" | jq -r '.TBA[0].downloads.linux.link') && \
    curl -sL "$TOOLBOX_URL" -o /tmp/toolbox.tar.gz && \
    mkdir -p /opt/jetbrains-toolbox && \
    tar -xzf /tmp/toolbox.tar.gz -C /opt/jetbrains-toolbox --strip-components=1 && \
    ln -s /opt/jetbrains-toolbox/bin/jetbrains-toolbox /usr/local/bin/jetbrains-toolbox && \
    rm /tmp/toolbox.tar.gz

# Install ChatGPT app and expose a stable binary path.
RUN dnf install -y https://persistent.oaistatic.com/codex-app-prod/linux/rpm/latest/chatgpt.x86_64.rpm

RUN dnf clean all

# Generate dummy host keys so the SSH daemon can start instantly
RUN ssh-keygen -A

# Lock down internal SSH daemon to keys-only
RUN echo -e "PasswordAuthentication no\nKbdInteractiveAuthentication no" > /etc/ssh/sshd_config.d/90-disable-passwords.conf

# link tools
RUN ln -s /usr/bin/distrobox-host-exec /usr/local/bin/flatpak && \
    ln -s /usr/bin/distrobox-host-exec /usr/local/bin/podman && \
    ln -s /usr/bin/distrobox-host-exec /usr/local/bin/podman-compose && \
    # ln -s /usr/bin/distrobox-host-exec /usr/bin/mise && \
    # ln -s /usr/bin/distrobox-host-exec /usr/local/bin/rpm-ostree && \
    ln -s /usr/bin/distrobox-host-exec /usr/bin/restic && \
    ln -s /usr/bin/distrobox-host-exec /usr/bin/rclone && \
    ln -s /usr/bin/distrobox-host-exec /usr/bin/chezmoi && \
    # ln -s /usr/bin/distrobox-host-exec /usr/local/bin/resticprofile && \
    ln -s /usr/bin/distrobox-host-exec /usr/local/bin/xdg-open

